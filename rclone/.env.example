# Nextcloud WebDAV Agent Workspace Mount Configuration (Example)
NEXTCLOUD_WEBDAV_URL=http://127.0.0.1:8081/remote.php/dav/files/USER/
NEXTCLOUD_USER=your_agent_username_or_email
NEXTCLOUD_PASSWORD=your_nextcloud_app_password_here
AGENT_WORKSPACE=${HOME}/rclone/agent-workspace
MOUNT_UID=1000
MOUNT_GID=1000

# Batch Mount Configuration (Optional overrides for rclone_mount_batch.sh)
# RCLONE_BATCH_BASE_DIR=/home/huang/rclone
# RCLONE_BATCH_REMOTES="remote1 remote2"
# RCLONE_BATCH_DEFAULT_MODE=daemon
# RCLONE_VFS_CACHE_MODE=full
# RCLONE_DIR_CACHE_TIME=10s
# RCLONE_ALLOW_OTHER=false
# RCLONE_MOUNT_TIMEOUT=30
# RCLONE_LOG_DIR=/tmp/rclone-batch-mounts

