[Unit]
Description=Nextcloud WebDAV Mount for Agent Workspace
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=__RCLONE_ENV_FILE__
ExecStart=__MOUNT_SCRIPT_PATH__ --foreground
ExecStop=/bin/fusermount3 -u __AGENT_WORKSPACE_PATH__
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
