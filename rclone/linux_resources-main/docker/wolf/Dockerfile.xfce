FROM ghcr.io/games-on-whales/xfce:edge

USER root

ARG USERNAME=retro
ARG USER_UID=1000
ARG USER_GID=1000

# 1. 建立/校正使用者與免密碼 sudo
RUN if getent passwd ${USER_UID} >/dev/null; then \
        EXISTING_USER=$(getent passwd ${USER_UID} | cut -d: -f1); \
        usermod -l ${USERNAME} ${EXISTING_USER} 2>/dev/null || true; \
    else \
        groupadd -g ${USER_GID} ${USERNAME} 2>/dev/null || true; \
        useradd -m -s /bin/bash -u ${USER_UID} -g ${USER_GID} ${USERNAME}; \
    fi \
    && mkdir -p /etc/sudoers.d \
    && echo "${USERNAME} ALL=(ALL:ALL) NOPASSWD: ALL" > /etc/sudoers.d/${USERNAME} \
    && chmod 0440 /etc/sudoers.d/${USERNAME}

# 2. 基礎工具、繁中字型、LibreOffice、系統監視器
RUN apt-get update && apt-get install -y \
    curl wget gpg git sudo jq fonts-noto-cjk fonts-noto-hinted \
    libreoffice libreoffice-l10n-zh-tw gnome-system-monitor \
    && rm -rf /var/lib/apt/lists/*

# 3. Brave 瀏覽器
RUN curl -fsSLo /usr/share/keyrings/brave-browser-archive-keyring.gpg https://brave-browser-apt-release.s3.brave.com/brave-browser-archive-keyring.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/brave-browser-archive-keyring.gpg] https://brave-browser-apt-release.s3.brave.com/ stable main" > /etc/apt/sources.list.d/brave-browser-release.list \
    && apt-get update && apt-get install -y brave-browser \
    && rm -rf /var/lib/apt/lists/*

# 4. VSCodium
RUN wget -qO - https://gitlab.com/paulcarroty/vscodium-deb-rpm-repo/raw/master/pub.gpg | gpg --dearmor -o /usr/share/keyrings/vscodium-archive-keyring.gpg \
    && echo 'deb [ signed-by=/usr/share/keyrings/vscodium-archive-keyring.gpg ] https://download.vscodium.com/debs vscodium main' > /etc/apt/sources.list.d/vscodium.list \
    && apt-get update && apt-get install -y codium \
    && rm -rf /var/lib/apt/lists/*

# 5. Obsidian
RUN DEB_URL=$(curl -s https://api.github.com/repos/obsidianmd/obsidian-releases/releases | grep -o 'https://[^"]*amd64\.deb' | head -n 1) \
    && wget -O /tmp/obsidian.deb "$DEB_URL" \
    && apt-get update && apt-get install -y /tmp/obsidian.deb \
    && rm -f /tmp/obsidian.deb \
    && rm -rf /var/lib/apt/lists/*
